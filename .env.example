# Supabase (sem estas variáveis o app roda em MODO DEMONSTRAÇÃO com dados fictícios)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Asaas — PIX (sandbox: https://api-sandbox.asaas.com/v3 • produção: https://api.asaas.com/v3)
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=

# Login do painel (chave PÚBLICA/publishable do Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# PIX direto na conta (sem gateway): QR Code com valor e código da reserva
PIX_KEY=
PIX_RECEIVER_NAME=
PIX_RECEIVER_CITY=Sao Joao del Rei

# WhatsApp do anfitrião (só números, com DDI): 5532999999999
NEXT_PUBLIC_WHATSAPP=
